{
  "name": "gitporch",
  "version": "0.1.0",
  "private": true,
  "description": "The GitPorch: a local-first Git repository porch and read-only dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "serve": "node src/cli.mjs serve",
    "test": "node --test test/*.test.mjs",
    "repos": "node src/cli.mjs list",
    "verify": "node src/cli.mjs verify",
    "check": "npm test",
    "clubhouse": "node src/clubhouse-cli.mjs",
    "crew": "node src/porch-crew-cli.mjs",
    "sandbox": "node src/sandbox-cli.mjs",
    "recovery": "node src/recovery-cli.mjs",
    "evidence": "node src/evidence-cli.mjs",
    "witness": "node src/witness-cli.mjs",
    "trust": "node src/trust-cli.mjs",
    "vault": "node src/vault-cli.mjs"
  },
  "license": "MIT"
}
