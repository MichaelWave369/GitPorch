{
  "name": "gitporch",
  "version": "0.1.0",
  "private": true,
  "description": "The GitPorch: a local-first Git repository porch and read-only dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "serve": "node src/cli.mjs serve",
    "test": "node --test test/*.test.mjs",
    "repos": "node src/cli.mjs list",
    "verify": "node src/cli.mjs verify",
    "check": "npm test",
    "clubhouse": "node src/clubhouse-cli.mjs",
    "crew": "node src/porch-crew-cli.mjs",
    "sandbox": "node src/sandbox-cli.mjs",
    "recovery": "node src/recovery-cli.mjs",
    "phirunners": "node src/phirunners-cli.mjs",
    "artifacts": "node src/artifact-cli.mjs",
    "builds": "node src/build-cli.mjs",
    "evidence": "node src/evidence-cli.mjs",
    "witness": "node src/witness-cli.mjs",
    "trust": "node src/trust-cli.mjs",
    "vault": "node src/vault-cli.mjs",
    "homenode": "node src/homenode-cli.mjs",
    "bridge": "node src/homenode-bridge-cli.mjs",
    "gateway": "node src/homenode-gateway-cli.mjs",
    "companion": "node src/homenode-companion-cli.mjs",
    "code-brown": "node src/code-brown-cli.mjs",
    "smergeon": "node src/smergeon-intake-cli.mjs",
    "audit:public-mirrors": "node src/homenode-bridge-cli.mjs audit"
  },
  "license": "MIT"
}
