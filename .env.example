# Local configuration (optional)
# GITPORCH_DATA_DIR=D:\GitPorchData
# GITPORCH_HTTP_PORT=3690
# GITPORCH_GIT_PORT=9418

# R1-H4: optional experimental independent HTTPS LAN metadata gateway.
# These are examples only. Do NOT store actual tokens, PEM keys or certificates in this repo.
# These variables alone do not start the service. Operator must run:
# npm run gateway -- serve --i-accept-lan-read-only
# GITPORCH_HOMENODE_BIND=127.0.0.1
# GITPORCH_HOMENODE_PORT=3743
# GITPORCH_HOMENODE_TLS_CERT_FILE=C:\\Private\\PhiOS\\tls-cert.pem
# GITPORCH_HOMENODE_TLS_KEY_FILE=C:\\Private\\PhiOS\\tls-key.pem
# GITPORCH_HOMENODE_TOKEN_FILE=C:\\Private\\PhiOS\\bearer-token.txt

# R1-H5 native companion. NEVER commit actual certs, tokens, or fingerprints gathered from private infrastructure.
# Set these in the client machine's operator environment only; none start a server.
# GITPORCH_COMPANION_IP=127.0.0.1
# GITPORCH_COMPANION_PORT=3743
# GITPORCH_COMPANION_CERT_FILE=C:\\Private\\PhiOS\\tls-cert.pem
# GITPORCH_COMPANION_TOKEN_FILE=C:\\Private\\PhiOS\\client-token.txt
# GITPORCH_COMPANION_CERT_SHA256=<independently-verified-64-hex-leaf-certificate-fingerprint>
